API_PORT=8787
LITELLM_BASE_URL=https://litellm.xtrip.click
LITELLM_MASTER_KEY=replace-with-litellm-master-key
STORE_FILE=./data/elaltidar.sqlite
DATABASE_URL=postgres://user:password@host:5432/elaltidar
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
ADMIN_TOKEN=replace-with-random-admin-token
CRON_SECRET=replace-with-random-cron-secret
ALLOW_DEV_LOGIN=true
